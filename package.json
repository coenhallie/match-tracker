{
  "name": "@coenhallie/match-tracker",
  "version": "0.2.0",
  "description": "A framework-free live 2D match tracker widget for football streams.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coenhallie/match-tracker.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./banner": {
      "types": "./dist/banner.d.ts",
      "import": "./dist/banner.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "copy-fonts": "node scripts/copy-fonts.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@types/node": "^26.6.4",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.44"
  }
}
